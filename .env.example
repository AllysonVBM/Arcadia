# Copie para .env e ajuste se necessário (opcional — tudo aqui já tem um
# valor padrão em player/config/llm_cfg.js e player/server_cfg.js).

# Qual identidade este processo roda (precisa estar em player/config/player_cfg.js)
AGENT_NAME=Pepper

# Endpoint do Ollama local
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo de chat já puxado no Ollama (ollama pull <nome>)
OLLAMA_MODEL=qwen3:8b

# Modelo de embeddings já puxado no Ollama, usado pela LTM (ollama pull <nome>)
OLLAMA_EMBED_MODEL=nomic-embed-text
